# Salin ke Railway → Variables (atau file .env saat dijalankan di komputer). JANGAN commit file .env.

# Wajib
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hirecup?retryWrites=true&w=majority
WAROENGPAY_API_KEY=wp_live_isi_dengan_key_BARU
ADMIN_PASSWORD=ganti_dengan_password_panjang

# Sangat disarankan
WAROENGPAY_WEBHOOK_SECRET=isi_dari_dashboard_waroengpay
WA_GROUP_LINK=https://chat.whatsapp.com/xxxxxxxx
PUBLIC_BASE_URL=https://domain-kamu.up.railway.app
GOOGLE_SHEET_URL=https://script.google.com/macros/s/xxxx/exec

# Opsional (nilai di bawah = default)
REGISTRATION_FEE=150000
PRIZE_BASE=100000
PRIZE_PER_TEAM=150000
MAX_TEAMS=32
REGISTRATION_CLOSE_AT=2026-12-29T23:59:00+07:00
PAYMENT_EXPIRES_MINUTES=30
